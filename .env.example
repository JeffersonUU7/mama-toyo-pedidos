# Copiar a .env y ajustar. NO subir .env al repositorio.
PORT=3000
NODE_ID=local
# Cambia esta contraseña si el clúster se va a usar fuera de tu computadora.
POSTGRES_PASSWORD=toyo_local
# Solo para desarrollo con la página abierta desde otro puerto (ej. un servidor estático en :5500).
# En producción déjalo vacío: la página y la API comparten origen y no se necesita CORS.
# CORS_ORIGIN=http://localhost:5500
